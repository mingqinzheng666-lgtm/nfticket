# Copy this file to .env and fill in your own values (used by Hardhat for Sepolia deploys).

# Sepolia RPC endpoint (Alchemy, Infura, etc.)
ALCHEMY_URL=https://eth-sepolia.g.alchemy.com/v2/your_key_here

# Deployer wallet private key WITHOUT the 0x prefix. Use a throwaway testnet wallet.
PRIVATE_KEY=your_private_key_here

# Optional: for `npm run verify` (contract source verification on Etherscan)
ETHERSCAN_API_KEY=your_etherscan_api_key_here
