# Copy this file to .env and fill in your own values.
# Vite only exposes variables prefixed with VITE_ to the frontend code.

# Pinata JWT for uploading event metadata / seat maps to IPFS
# Get one at https://app.pinata.cloud -> API Keys
VITE_PINATA_JWT=your_pinata_jwt_here

# Sepolia RPC endpoint for read-only contract calls (Alchemy, Infura, etc.)
# Only needed when TARGET_CHAIN_ID is Sepolia; local Hardhat uses http://127.0.0.1:8545
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your_key_here
